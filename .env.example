# Yuni Environment Configuration
# OpenRouter API Key for Cloud AI (Edge Function or BYOK)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here

# Always route to generous Nvidia Nemotron models
VITE_OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning:free
VITE_OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Site info for OpenRouter analytics headers
VITE_SITE_URL=https://yuni.muhas.ac.tz
VITE_SITE_NAME="Yuni Life - MUHAS Student App"
